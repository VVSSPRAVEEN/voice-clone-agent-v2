# =============================================================================
# Voice Clone Agent - Environment Configuration
# Copy this file to backend\.env and adjust values as needed (config.py
# loads .env from the backend working directory).
# =============================================================================

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
# Pipeline mode: "parallel" (default, streaming segments) or "sequential"
PIPELINE_MODE=parallel
# Max concurrent calls (others queue). 1 = strict serial.
MAX_CONCURRENT_CALLS=1

# --- Paths ---
DATA_DIR=/app/data
SPEAKERS_DIR=/app/data/speakers
CALLS_DIR=/app/data/calls
MODELS_DIR=/app/data/models
DB_PATH=/app/data/calls.db
# HF cache root for huggingface_hub downloads (Chatterbox/Praxy, faster-whisper,
# Qwen AWQ). NOTE: HF_HOME is read directly by huggingface_hub, NOT by
# pydantic-settings. config.py already sets it at import time:
#   os.environ.setdefault("HF_HOME", "D:/hf-models")
# HF_HOME=D:/hf-models

# --- GPU ---
CUDA_VISIBLE_DEVICES=0
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128
# Force CPU even if CUDA is available (debug)
FORCE_CPU=false
# Auto-run STT/Praxy/XTTS on CPU when free VRAM is too low (default true).
# Set false to restore the old always-CUDA behaviour.
# AUTO_CPU_FALLBACK=true

# --- STT (faster-whisper) ---
STT_MODEL=medium
STT_COMPUTE_TYPE=int8
STT_DEVICE_CUDA=true
STT_LANGUAGE=te          # Telugu default; use "auto" for autodetect
STT_BEAM_SIZE=1          # 1 = fastest, 5 = better accuracy

# --- VAD (Silero) ---
VAD_THRESHOLD=0.5
VAD_MIN_SPEECH_MS=250
VAD_MAX_SPEECH_MS=30000
VAD_SILENCE_MS=500

# --- TTS ---
# Engine: "edge" (default; online preset voices, best Telugu),
#         "xtts" (Coqui XTTS v2, zero-shot multilingual cloning),
#         "sherpa" (sherpa-onnx VITS, faster, smaller, less expressive),
#         "ai4bharat" (indic-tts), or "hybrid" (auto-routing:
#         Praxy for te/ta, XTTS for en/hi, Edge-TTS fallback)
TTS_ENGINE=xtts
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_DEVICE=cuda         # cuda | cpu
XTTS_LANGUAGE=te         # ISO code for TTS target language
# Speaker cloning reference: 3-10s clip required per speaker

# --- LLM (local vLLM) ---
# LLM runs as a separate local vLLM server process (OpenAI-compatible API).
# Set LLM_ENABLED=false to use the rule-based fallback.
LLM_ENABLED=true
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct-AWQ
LLM_API_URL=http://127.0.0.1:8001
LLM_SYSTEM_PROMPT=You are a friendly bilingual voice agent. Reply in the same language the user spoke (Telugu or English). Keep replies under 2 sentences unless asked for detail.
LLM_MAX_TOKENS=128
LLM_TEMPERATURE=0.7

# --- Audio I/O ---
SAMPLE_RATE=16000        # STT/VAD work at 16k
TTS_SAMPLE_RATE=24000    # XTTS native rate
CHANNELS=1
CHUNK_MS=20              # WebSocket audio chunk interval

# --- Storage ---
# Audio storage: "local" filesystem | "minio" (S3-compatible)
STORAGE_BACKEND=local
# MinIO (only used if STORAGE_BACKEND=minio)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=voice-clone-agent
MINIO_SECURE=false

# --- Auth (frontend->backend) ---
AUTH_MODE=none           # none | apikey
API_KEY=change-me
